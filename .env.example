# Copy to .env and fill in what you need. Everything is optional for a local demo.

# Database — defaults to a local SQLite file (freshchain.db) when unset.
# DATABASE_URL=postgresql+psycopg://USER@localhost:5432/freshchain

# Gemini — leave empty to use the deterministic rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Background monitor ("cron"): seconds between risk sweeps. 0 disables it.
MONITOR_INTERVAL_SECONDS=300

# Execute AI decisions without human approval (autonomous mode).
AUTO_EXECUTE=false

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Optional: POST every executed action here (e.g. a Slack/Discord incoming webhook).
# WEBHOOK_URL=

# Optional: BigQuery analytics export (requires google-cloud-bigquery + GCP credentials).
# BIGQUERY_DATASET=my-project.freshchain
